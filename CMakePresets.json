{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
        "BUILD_TESTING": "OFF",
        "OPENSSL_USE_STATIC_LIBS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "displayName": "Debug Build",
      "binaryDir": "${sourceDir}/.build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "_linux",
      "inherits": "default",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "_mac",
      "inherits": "default",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_MACOSX_BUNDLE": "ON"
      }
    },
    {
      "name": "_windows",
      "inherits": "default",
      "hidden": true,
      "toolchainFile": "${sourceDir}/cmake/toolchain-mingw.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "JPDF_DESK_WITH_OPENSSL": "OFF",
        "QT_HOST_PATH": "${sourceDir}/.build/release-linux",
        "JPDF_DESK_SINGLE_EXECUTABLE": "ON"
      }
    },
    {
      "name": "release-linux",
      "inherits": "_linux",
      "binaryDir": "${sourceDir}/.build/release-linux",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "/usr"
      }
    },
    {
      "name": "release-windows",
      "inherits": "_windows",
      "displayName": "MinGW Release Build",
      "binaryDir": "${sourceDir}/.build/release-windows"
    },
    {
      "name": "release-mac-arm64",
      "inherits": "_mac",
      "displayName": "macOS Apple Silicon application",
      "description": "Build natively on Apple Silicon macOS; supply OPENSSL_ROOT_DIR if needed.",
      "binaryDir": "${sourceDir}/.build/release-mac-arm64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "release-linux-static",
      "inherits": "_linux",
      "displayName": "Linux single executable",
      "binaryDir": "${sourceDir}/.build/release-linux-static"
    },
    {
      "name": "release-linux-arm64",
      "inherits": "_linux",
      "displayName": "Linux AArch64 cross-build",
      "description": "Requires AArch64 GCC/G++, a populated /opt/sysroot, and native Qt host tools built with release-linux.",
      "binaryDir": "${sourceDir}/.build/release-linux-arm64",
      "toolchainFile": "${sourceDir}/cmake/aarch64-toolchain.cmake",
      "cacheVariables": {
        "QT_HOST_PATH": "${sourceDir}/.build/release-linux"
      }
    },
    {
      "name": "release-windows-static",
      "inherits": "_windows",
      "displayName": "Windows single executable",
      "binaryDir": "${sourceDir}/.build/release-windows-static"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release-linux",
      "configurePreset": "release-linux"
    },
    {
      "name": "release-windows",
      "configurePreset": "release-windows"
    },
    {
      "name": "release-mac-arm64",
      "configurePreset": "release-mac-arm64",
      "targets": [
        "jpdf-desk"
      ]
    },
    {
      "name": "default",
      "configurePreset": "release-linux"
    },
    {
      "name": "release-linux-static",
      "configurePreset": "release-linux-static",
      "targets": [
        "jpdf-desk"
      ]
    },
    {
      "name": "release-linux-arm64",
      "configurePreset": "release-linux-arm64",
      "targets": [
        "jpdf-desk"
      ]
    },
    {
      "name": "release-windows-static",
      "configurePreset": "release-windows-static",
      "targets": [
        "jpdf-desk"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "packagePresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "generators": [
        "DEB"
      ]
    },
    {
      "name": "release-linux-deb",
      "configurePreset": "release-linux",
      "generators": [
        "DEB"
      ]
    },
    {
      "name": "release-linux-rpm",
      "configurePreset": "release-linux",
      "generators": [
        "RPM"
      ]
    },
    {
      "name": "release-windows-installer",
      "configurePreset": "release-windows",
      "generators": [
        "NSIS"
      ]
    }
  ]
}

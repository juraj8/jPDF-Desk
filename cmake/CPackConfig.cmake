# Package only the application, never the vendored Qt SDK or build tools.
set(CPACK_PACKAGE_NAME ${PROJECT_NAME})
set(CPACK_PACKAGE_VENDOR "${JPDF_DESK_AUTHOR}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "${PROJECT_DESCRIPTION}")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_CONTACT "${JPDF_DESK_AUTHOR_EMAIL}")
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_BINARY_DIR}/packages")
set(CPACK_PACKAGE_FILE_NAME "${PROJECT_NAME}-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_COMPONENTS_ALL Runtime)
set(CPACK_ARCHIVE_COMPONENT_INSTALL ON)

if(UNIX AND NOT APPLE)
    if(NOT CPACK_GENERATOR)
        set(CPACK_GENERATOR "DEB")
    endif()
    set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
    set(CPACK_DEB_COMPONENT_INSTALL ON)
    set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
    set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${JPDF_DESK_AUTHOR}")
    if(JPDF_DESK_AUTHOR_EMAIL)
        string(APPEND CPACK_DEBIAN_PACKAGE_MAINTAINER " <${JPDF_DESK_AUTHOR_EMAIL}>")
    endif()
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    set(CPACK_RPM_COMPONENT_INSTALL ON)
    set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
    # Application: MIT; bundled MuPDF: AGPL (unless commercially licensed).
    set(CPACK_RPM_PACKAGE_LICENSE "MIT AND AGPL-3.0-or-later")
    set(CPACK_RPM_PACKAGE_AUTOREQPROV ON)
endif()

if(WIN32)
    if(NOT CPACK_GENERATOR)
        set(CPACK_GENERATOR "NSIS")
    endif()
    set(CPACK_NSIS_MUI_ICON "${PROJECT_SOURCE_DIR}/branding/jpdf-desk.ico")
    set(CPACK_NSIS_MUI_UNIICON "${PROJECT_SOURCE_DIR}/branding/jpdf-desk.ico")
    set(CPACK_NSIS_DISPLAY_NAME "${JPDF_DESK_DISPLAY_NAME}")
    set(CPACK_NSIS_PACKAGE_NAME "${JPDF_DESK_DISPLAY_NAME}")
    set(CPACK_NSIS_CONTACT "${CPACK_PACKAGE_CONTACT}")
    set(CPACK_NSIS_URL_INFO_ABOUT "${JPDF_DESK_PROJECT_URL}")
    set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
    set(CPACK_NSIS_EXECUTABLES_DIRECTORY "bin")
    set(CPACK_PACKAGE_EXECUTABLES "jpdf-desk" "${JPDF_DESK_DISPLAY_NAME}")
    set(CPACK_CREATE_DESKTOP_LINKS "jpdf-desk")

    configure_file("${PROJECT_SOURCE_DIR}/packaging/windows-associations-install.nsh.in"
        "${PROJECT_BINARY_DIR}/windows-associations-install.nsh" @ONLY)
    file(READ "${PROJECT_BINARY_DIR}/windows-associations-install.nsh"
        CPACK_NSIS_EXTRA_INSTALL_COMMANDS)
    file(READ "${PROJECT_SOURCE_DIR}/packaging/windows-associations-uninstall.nsh"
        CPACK_NSIS_EXTRA_UNINSTALL_COMMANDS)
endif()

# Preserve NSIS registry paths, quotes, and dollar signs in CPackConfig.cmake.
set(CPACK_VERBATIM_VARIABLES ON)
include(CPack)
